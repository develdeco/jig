+package mathutil
+
+// Clamp restrict v to lie between lo and hi.
+func Clamp(v, lo, hi int) int {
+	if v < lo {
+		return lo
+	}
+	if v > hi {
+		return hi
+	}
+	return v
+}
+
+func unusedHelper(x int) int {
+	return x * 2
+}
+
+func Average(nums []int) int {
+	if len(nums) == 0 {
+		return 0
+	}
+	total := 0
+	for _, n := range nums {
+		total += n
+	}
+	return total / len(nums)
+}
