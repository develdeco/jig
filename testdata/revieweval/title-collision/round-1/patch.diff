+package store
+
+import (
+	"io"
+	"os"
+)
+
+// ReadAll returns the full contents of the read-only file at path.
+func ReadAll(path string) ([]byte, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	data := make([]byte, 0)
+	buf := make([]byte, 4096)
+	for {
+		n, rerr := f.Read(buf)
+		data = append(data, buf[:n]...)
+		if rerr != nil {
+			if rerr != io.EOF {
+				return nil, rerr
+			}
+			break
+		}
+	}
+	return data, nil
+}
