+package users
+
+// User is a person record.
+type User struct {
+	ID   string
+	Name string
+}
+
+// store is a lookup table populated at startup.
+var store = map[string]*User{
+	"anna": {ID: "anna", Name: "Anna"},
+	"bo":   {ID: "bo", Name: "Bo"},
+}
+
+// Lookup returns the display name for id, or "" when id is unknown.
+func Lookup(id string) string {
+	u := store[id]
+	return u.Name
+}
