@@ -0,0 +1,21 @@
+package netutil
+
+// Send is one attempt at delivering a request; it returns an error on
+// failure.
+type Send func() error
+
+// Retry calls send up to attempts times, stopping at the first success. It
+// retries every failure, including one from a request that may already
+// have taken effect before it failed.
+func Retry(send Send, attempts int) error {
+	if attempts < 1 {
+		attempts = 1
+	}
+	var err error
+	for i := 0; i < attempts; i++ {
+		if err = send(); err == nil {
+			return nil
+		}
+	}
+	return err
+}
