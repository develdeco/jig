+package worker
+
+// RunAll starts task(job) for every job in jobs, one goroutine per job, and
+// waits for all of them to finish before returning.
+func RunAll(jobs []string, task func(string)) {
+	done := make(chan struct{}, len(jobs))
+	for _, job := range jobs {
+		go func() {
+			task(job)
+			done <- struct{}{}
+		}()
+	}
+	for range jobs {
+		<-done
+	}
+}
