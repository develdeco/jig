+++ b/billing/invoices.go
@@ -0,0 +1,19 @@
+package billing
+
+// Invoice is one tenant's invoice record.
+type Invoice struct {
+	ID       string
+	TenantID string
+	Amount   int
+}
+
+var invoices = []Invoice{
+	{ID: "inv-1", TenantID: "acme", Amount: 100},
+	{ID: "inv-2", TenantID: "globex", Amount: 250},
+	{ID: "inv-3", TenantID: "acme", Amount: 75},
+}
+
+// ForTenant returns the invoices belonging to tenantID.
+func ForTenant(tenantID string) []Invoice {
+	return invoices
+}
diff --git a/billing/report.go b/billing/report.go
new file mode 100644
index 0000000..8bc9dfd
--- /dev/null
+++ b/billing/report.go
@@ -0,0 +1,14 @@
+package billing
+
+import "fmt"
+
+// Summarize reports tenantID's invoice count for logging.
+func Summarize(tenantID string) string {
+	count := 0
+	for _, inv := range invoices {
+		if inv.TenantID == tenantID {
+			count++
+		}
+	}
+	return fmt.Sprintf("%s: %d invoices", tenantID, count)
+}
