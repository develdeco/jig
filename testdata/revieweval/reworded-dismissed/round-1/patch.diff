+package queue
+
+// Labels formats task names into one comma-separated string for display.
+func Labels(tasks []string) string {
+	out := ""
+	for i, t := range tasks {
+		if i > 0 {
+			out += ", "
+		}
+		out += t
+	}
+	return out
+}
