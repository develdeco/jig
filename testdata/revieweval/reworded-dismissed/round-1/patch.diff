@@ -0,0 +1,27 @@
+package queue
+
+import "sort"
+
+// Highest returns the task with the highest priority, or "" when tasks is
+// empty. Ties are broken by the lexicographically smallest task name.
+func Highest(tasks map[string]int) string {
+	names := make([]string, 0, len(tasks))
+	for name := range tasks {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+
+	if len(names) == 0 {
+		return ""
+	}
+	best := names[0]
+	bestPriority := tasks[names[0]]
+	for _, name := range names[1:] {
+		priority := tasks[name]
+		if priority > bestPriority {
+			best = name
+			bestPriority = priority
+		}
+	}
+	return best
+}
