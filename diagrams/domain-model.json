  "cards": [
    {
      "dot": "cyan",
      "title": "How a ticket moves",
      "items": [
        "Brief: intake writes brief.md and slices.yaml; jig validate approves the brief, pinned to its sha256.",
        "Build: a session claims a slice and commits with a Jig-Slice trailer; jig verifies the commit in the background.",
        "Review: jig gate opens a round, a fresh reviewer closes it; a fix finding becomes a new slice, never a back-edge.",
        "Publish: the reviewed head is pushed unchanged and the PR body and changelog render from the journal."
      ]
    },
    {
      "dot": "amber",
      "title": "Rules the links carry",
      "items": [
        "Green is what a verification proved, never what a session claimed.",
        "Editing a section a verified slice cites is brief drift; editing the brief withdraws its approval.",
        "A merged blocker holds a ticket until its PR merges; a stacked one starts it from the parent's branch.",
        "A phase is done only when every phase before it is."
      ]
    },
    {
      "dot": "slate",
      "title": "Left out of this view",
      "items": [
        "Mirror: GitHub issues and the board copy tickets and charts outward and are never read back.",
        "Questions, notes and corrections a session hears, and the machine-local ledger of sessions.",
        "The project marker jig.yaml that names the repos and finds the store."
      ]
    }
  ]
}
