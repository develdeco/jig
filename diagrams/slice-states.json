  "cards": [
    {
      "dot": "emerald",
      "title": "Only a verification makes green",
      "items": [
        "A passing oracle on a commit naming the slice marks it green from any state.",
        "A failing one sends it back to building, unless a question is open."
      ]
    },
    {
      "dot": "amber",
      "title": "Ready is computed, not stored",
      "items": [
        "The frontier is every queued slice whose blockers are all green: jig next.",
        "A claim of a stalled or env-blocked slice also moves it to building."
      ]
    }
