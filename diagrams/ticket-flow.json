  "cards": [
    {
      "dot": "cyan",
      "title": "Phases are asked for by prompt",
      "items": [
        "Plan T, Build T, Review T, Publish T each start one phase with its skill.",
        "A prompt naming several phases runs them in order; a refusal ends the run.",
        "Where a ticket stands is derived from its journal, never recorded."
      ]
    },
    {
      "dot": "amber",
      "title": "The person's two moments",
      "items": [
        "Confirming the brief and approving the publish stay the person's.",
        "A prompt can delegate them; the approval is then recorded with agent provenance."
      ]
    },
    {
      "dot": "rose",
      "title": "Review has no back-edges",
      "items": [
        "A fix finding becomes a new slice queued from the round, not an edit of the old one.",
        "The fix budget caps unattended fix rounds; past it, fixes park for a person."
      ]
    }
  ]
