  "cards": [
    {
      "dot": "cyan",
      "title": "Who owns what",
      "items": [
        "The harness owns the session, its model and its tools; jig starts no session and picks no model.",
        "The binary owns the machinery: state, verification, git and the hooks that observe.",
        "Skills own judgment: reading a brief, writing code, reviewing a diff."
      ]
    },
    {
      "dot": "amber",
      "title": "Two paths start a verification",
      "items": [
        "Git's post-commit hook, through jig githook post-commit.",
        "The harness's tool hook, when a command moved HEAD; a verify-spawned ledger line keeps it to one run."
      ]
    },
    {
      "dot": "slate",
      "title": "Left out of this view",
      "items": [
        "jig tui, which runs verbs as the person and reads jig events.",
        "The pooled worktrees (leases) a gate round and a publish check out.",
        "The session can push and open the PR itself; jig publish --pr then records it."
      ]
    }
  ]
