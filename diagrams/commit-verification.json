  "cards": [
    {
      "dot": "emerald",
      "title": "Green is a record",
      "items": [
        "Green is what a verification proved on a commit, never what a session claimed.",
        "Lines are keyed by commit and slice, so a second run of the same pair changes nothing."
      ]
    },
    {
      "dot": "amber",
      "title": "Nothing is shared in memory",
      "items": [
        "The worker is its own process; the store and the machine ledger are the whole interface.",
        "The hook core keeps no state: it reads the ledger back to know what a session was told."
      ]
    }
